---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const title = "Blog Treinar IA Brasil | Dicas, Renda Extra e Inteligência Artificial";
const description = "Artigos práticos, tutoriais passo a passo e dicas exclusivas para maximizar seus ganhos em dólar com treinamento de IA no Brasil.";

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  'itemListElement': [
    {
      '@type': 'ListItem',
      'position': 1,
      'name': 'Início',
      'item': 'https://treinariabrasil.com.br/'
    },
    {
      '@type': 'ListItem',
      'position': 2,
      'name': 'Blog',
      'item': 'https://treinariabrasil.com.br/blog'
    }
  ]
};
---

<BaseLayout
  title={title}
  description={description}
  jsonLd={breadcrumbJsonLd}
>
  <div class="py-12 sm:py-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
    
    <!-- Header -->
    <div class="max-w-3xl">
      <nav class="flex items-center gap-2 text-xs text-slate-500 mb-4" aria-label="Navegação em trilha">
        <a href="/" class="hover:text-slate-900 transition-colors">Início</a>
        <span>/</span>
        <span class="text-emerald-700 font-bold">Blog</span>
      </nav>

      <span class="text-xs font-bold uppercase tracking-wider text-emerald-800 bg-emerald-50 px-3 py-1 rounded-full border border-emerald-200">
        Artigos & Estratégias
      </span>
      <h1 class="text-3xl sm:text-5xl font-extrabold text-slate-900 mt-4">
        Blog Treinar IA Brasil
      </h1>
      <p class="text-slate-600 text-base sm:text-lg mt-4 leading-relaxed font-normal">
        Guias completos, tutoriais de gravação e análises aprofundadas sobre como faturar em dólar no mercado global de dados para inteligência artificial.
      </p>
    </div>

    <!-- Posts Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {posts.map((post) => (
        <article class="bg-white rounded-3xl p-7 border border-slate-200/90 shadow-sm hover:border-emerald-300 hover:shadow-md transition-all flex flex-col justify-between">
          <div class="space-y-4">
            <div class="flex items-center justify-between text-xs text-slate-500">
              <span class="px-3 py-1 rounded-full bg-emerald-50 text-emerald-800 font-bold border border-emerald-200">
                {post.data.category}
              </span>
              <span>{post.data.readingTime} de leitura</span>
            </div>

            <h2 class="text-xl sm:text-2xl font-bold text-slate-900 hover:text-emerald-700 transition-colors leading-snug">
              <a href={`/blog/${post.slug}`}>
                {post.data.title}
              </a>
            </h2>

            <p class="text-sm text-slate-600 leading-relaxed line-clamp-3 font-normal">
              {post.data.description}
            </p>
          </div>

          <div class="pt-6 mt-6 border-t border-slate-100 flex items-center justify-between text-xs text-slate-500">
            <span>Por <strong class="text-slate-700">{post.data.author}</strong></span>
            <a
              href={`/blog/${post.slug}`}
              class="inline-flex items-center font-bold text-emerald-600 hover:text-emerald-700 transition-colors"
            >
              Ler artigo
              <svg class="w-3.5 h-3.5 ml-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
              </svg>
            </a>
          </div>
        </article>
      ))}
    </div>

  </div>
</BaseLayout>
