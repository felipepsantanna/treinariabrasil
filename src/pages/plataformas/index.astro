---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import PlatformCard from '@/components/platforms/PlatformCard.astro';

const allPlatforms = await getCollection('platforms');
const publishedPlatforms = allPlatforms
  .filter((p) => p.data.status === 'published')
  .sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));

const title = "Melhores Plataformas para Treinar IA no Brasil (2026)";
const description = "Compare as principais plataformas que pagam para gravar vídeos e tarefas para treinar inteligência artificial. Valores por hora, requisitos e Pix.";

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  'itemListElement': [
    {
      '@type': 'ListItem',
      'position': 1,
      'name': 'Início',
      'item': 'https://treinariabrasil.com.br/'
    },
    {
      '@type': 'ListItem',
      'position': 2,
      'name': 'Plataformas',
      'item': 'https://treinariabrasil.com.br/plataformas'
    }
  ]
};
---

<BaseLayout
  title={title}
  description={description}
  jsonLd={breadcrumbJsonLd}
>
  <div class="py-12 sm:py-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-16">
    
    <!-- Hero Header -->
    <div class="max-w-3xl">
      <nav class="flex items-center gap-2 text-xs text-slate-500 mb-4" aria-label="Navegação em trilha">
        <a href="/" class="hover:text-slate-900 transition-colors">Início</a>
        <span>/</span>
        <span class="text-emerald-700 font-bold">Plataformas</span>
      </nav>

      <span class="text-xs font-bold uppercase tracking-wider text-emerald-800 bg-emerald-50 px-3 py-1 rounded-full border border-emerald-200">
        Catálogo Homologado
      </span>
      <h1 class="text-3xl sm:text-5xl font-extrabold text-slate-900 mt-4">
        Plataformas que Pagam para Treinar IA
      </h1>
      <p class="text-slate-600 text-base sm:text-lg mt-4 leading-relaxed font-normal">
        Descubra e compare as plataformas ativas no Brasil. Analisamos detalhadamente a reputação, estabilidade dos aplicativos, compatibilidade com celulares e prazos reais de pagamento.
      </p>
    </div>

    <!-- Active Platforms Grid -->
    <div>
      <div class="flex items-center justify-between mb-8">
        <h2 class="text-2xl font-bold text-slate-900 flex items-center gap-3">
          <span>Plataformas Publicadas & Verificadas</span>
          <span class="text-xs bg-emerald-100 text-emerald-800 px-3 py-1 rounded-full font-bold">
            {publishedPlatforms.length} disponíveis
          </span>
        </h2>
      </div>

      <div class="flex flex-col gap-6">
        {publishedPlatforms.map((platform) => (
          <PlatformCard platform={platform.data} />
        ))}
      </div>
    </div>

    <!-- Comparison Matrix Table (Clean Light) -->
    <div class="bg-white rounded-3xl p-6 sm:p-10 border border-slate-200 shadow-sm space-y-6">
      <div>
        <h2 class="text-2xl font-bold text-slate-900">Tabela Comparativa Rápida</h2>
        <p class="text-sm text-slate-500 mt-1">Visão lado a lado dos principais critérios para ajudar na sua escolha.</p>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full text-left text-sm text-slate-700">
          <thead class="text-xs uppercase bg-slate-50 text-slate-600 border-b border-slate-200">
            <tr>
              <th class="py-3 px-4 font-bold">Plataforma</th>
              <th class="py-3 px-4 font-bold">Categoria</th>
              <th class="py-3 px-4 font-bold">Faixa de Ganho</th>
              <th class="py-3 px-4 font-bold">Forma de Saque</th>
              <th class="py-3 px-4 font-bold">Mínimo</th>
              <th class="py-3 px-4 text-right font-bold">Ação</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100 text-xs sm:text-sm">
            {publishedPlatforms.map((p) => (
              <tr class="hover:bg-slate-50 transition-colors">
                <td class="py-4 px-4 font-bold text-slate-900 flex items-center gap-2">
                  <img src={p.data.logo} alt="" class="w-6 h-6 object-contain" />
                  {p.data.name}
                </td>
                <td class="py-4 px-4 text-slate-600">{p.data.category}</td>
                <td class="py-4 px-4 font-bold text-emerald-600">
                  {p.data.pricing.displayLabel || `${p.data.pricing.currency} ${p.data.pricing.min || 0} - ${p.data.pricing.max || 0}/h`}
                </td>
                <td class="py-4 px-4 text-slate-600">{p.data.payment.methods.join(', ') || 'Pix'} ({p.data.payment.avgTime})</td>
                <td class="py-4 px-4 text-slate-600 font-semibold">{p.data.payment.minWithdrawal || 'R$ 25'}</td>
                <td class="py-4 px-4 text-right">
                  <a
                    href={`/plataformas/${p.data.id}`}
                    class="inline-flex items-center px-3 py-1.5 rounded-lg bg-slate-100 hover:bg-emerald-50 hover:text-emerald-700 text-slate-800 font-bold transition-colors border border-slate-200"
                  >
                    Ver análise
                  </a>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>

  </div>
</BaseLayout>
