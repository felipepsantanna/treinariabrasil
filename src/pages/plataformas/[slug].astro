---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import PlatformDetail from '@/components/platforms/PlatformDetail.astro';

export async function getStaticPaths() {
  const platforms = await getCollection('platforms');
  return platforms
    .filter((platform) => platform.data.status === 'published')
    .map((platform) => ({
      params: { slug: platform.data.id },
      props: { platform },
    }));
}

export interface Props {
  platform: CollectionEntry<'platforms'>;
}

const { platform } = Astro.props;
const p = platform.data;

const pageTitle = `${p.name}: Como Funciona, Cadastro e Quanto Paga | Treinar IA`;
const pageDescription = `Confira a análise completa de ${p.name}: requisitos de gravação, celulares compatíveis, quanto paga por hora e como receber via Pix no Brasil.`;

// JSON-LD Schemas: Product / Review / Offers + BreadcrumbList
const hasPriceRange = p.pricing.min !== null && p.pricing.max !== null && p.pricing.min !== p.pricing.max;

const offersJsonLd = hasPriceRange
  ? {
      '@type': 'AggregateOffer',
      'priceCurrency': p.pricing.currency,
      'lowPrice': p.pricing.min,
      'highPrice': p.pricing.max,
      'offerCount': 1,
      'price': p.pricing.min,
      'availability': 'https://schema.org/InStock',
      'url': `https://treinariabrasil.com.br/plataformas/${p.id}`,
    }
  : {
      '@type': 'Offer',
      'priceCurrency': p.pricing.currency,
      'price': p.pricing.min ?? p.pricing.max ?? 0,
      'availability': 'https://schema.org/InStock',
      'url': `https://treinariabrasil.com.br/plataformas/${p.id}`,
    };

const ratingValue = p.rating || 4.5;
const ratingCount = p.reviewsCount || 100;

const productJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  'name': p.name,
  'description': p.summary || `Plataforma de renda extra treinando modelos de IA: ${p.name}`,
  'image': `https://treinariabrasil.com.br${p.logo}`,
  'category': p.category,
  'brand': {
    '@type': 'Brand',
    'name': p.name,
  },
  'sku': p.id,
  'aggregateRating': {
    '@type': 'AggregateRating',
    'ratingValue': ratingValue,
    'bestRating': '5.0',
    'worstRating': '1.0',
    'ratingCount': ratingCount,
  },
  'review': {
    '@type': 'Review',
    'reviewRating': {
      '@type': 'Rating',
      'ratingValue': ratingValue,
      'bestRating': '5.0',
      'worstRating': '1.0',
    },
    'author': {
      '@type': 'Organization',
      'name': 'Treinar IA Brasil',
      'url': 'https://treinariabrasil.com.br',
    },
    'reviewBody': p.summary || `Análise detalhada e guia completo da plataforma ${p.name} para tarefas de treinamento de inteligência artificial.`,
  },
  'offers': offersJsonLd,
};

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  'itemListElement': [
    {
      '@type': 'ListItem',
      'position': 1,
      'name': 'Início',
      'item': 'https://treinariabrasil.com.br/'
    },
    {
      '@type': 'ListItem',
      'position': 2,
      'name': 'Plataformas',
      'item': 'https://treinariabrasil.com.br/plataformas'
    },
    {
      '@type': 'ListItem',
      'position': 3,
      'name': p.name,
      'item': `https://treinariabrasil.com.br/plataformas/${p.id}`
    }
  ]
};
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  type="product"
  jsonLd={[productJsonLd, breadcrumbJsonLd]}
>
  <div class="py-10 sm:py-16 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Breadcrumb visual -->
    <nav class="flex items-center gap-2 text-xs text-slate-400 mb-8" aria-label="Navegação em trilha">
      <a href="/" class="hover:text-white transition-colors">Início</a>
      <span>/</span>
      <a href="/plataformas" class="hover:text-white transition-colors">Plataformas</a>
      <span>/</span>
      <span class="text-brand-accent font-semibold">{p.name}</span>
    </nav>

    <!-- Platform Detail Component -->
    <PlatformDetail platform={p} />

  </div>
</BaseLayout>
