---
import '@/styles/global.css';
import SEO from '@/components/common/SEO.astro';
import Header from '@/components/common/Header.astro';
import Footer from '@/components/common/Footer.astro';
import CookieBanner from '@/components/common/CookieBanner.astro';

export interface Props {
  title: string;
  description: string;
  canonical?: string;
  image?: string;
  type?: 'website' | 'article' | 'product';
  jsonLd?: Record<string, any> | Array<Record<string, any>>;
}

const { title, description, canonical, image, type, jsonLd } = Astro.props;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=AW-18487107650"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'AW-18487107650');

      function gtag_report_conversion(url) {
        var navigated = false;
        var callback = function () {
          if (!navigated) {
            navigated = true;
            if (typeof(url) != 'undefined' && url) {
              window.location = url;
            }
          }
        };
        // Fallback para evitar travamento em caso de bloqueadores de anúncio ou conexão lenta
        setTimeout(callback, 800);
        try {
          gtag('event', 'conversion', {
              'send_to': 'AW-18487107650/pf9CCJ_q7IwdEMLAq-9E',
              'value': 1.0,
              'currency': 'BRL',
              'event_callback': callback
          });
        } catch (e) {
          callback();
        }
        return false;
      }
      window.gtag_report_conversion = gtag_report_conversion;
    </script>

    <SEO
      title={title}
      description={description}
      canonical={canonical}
      image={image}
      type={type}
      jsonLd={jsonLd}
    />
  </head>
  <body class="bg-slate-50 text-slate-800 min-h-screen flex flex-col selection:bg-emerald-600 selection:text-white">
    <!-- Skip to main content for accessibility -->
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 z-50 px-4 py-2 bg-emerald-600 text-white font-bold rounded-lg shadow-lg"
    >
      Pular para o conteúdo principal
    </a>

    <Header />

    <main id="main-content" class="flex-grow pt-20">
      <slot />
    </main>

    <Footer />
    <CookieBanner />
  </body>
</html>
