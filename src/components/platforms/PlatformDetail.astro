---
import type { CollectionEntry } from 'astro:content';

export interface Props {
  platform: CollectionEntry<'platforms'>['data'];
}

const { platform } = Astro.props;
const normalizedPlatformId = platform.id === 'hub-xyz' ? 'hub' : platform.id;

const formatPricing = () => {
  if (platform.pricing.displayLabel) return platform.pricing.displayLabel;
  if (platform.pricing.min && platform.pricing.max) {
    const symbol = platform.pricing.currency === 'USD' ? '$' : 'R$ ';
    return `${symbol}${platform.pricing.min} a ${symbol}${platform.pricing.max} / ${platform.pricing.unit}`;
  }
  if (platform.pricing.max) {
    const symbol = platform.pricing.currency === 'USD' ? '$' : 'R$ ';
    return `até ${symbol}${platform.pricing.max} / ${platform.pricing.unit}`;
  }
  return 'A consultar';
};
---

<div class="space-y-12 max-w-5xl mx-auto">
  
  <!-- Header Card Hero (Clean Light) -->
  <div class="bg-white rounded-3xl p-6 sm:p-10 border border-slate-200/90 shadow-sm relative overflow-hidden">
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-6 relative z-10">
      
      <div class="flex items-start sm:items-center gap-5">
        <div class="w-20 h-20 sm:w-24 sm:h-24 rounded-2xl bg-slate-50 p-3 border border-slate-200 flex-shrink-0 flex items-center justify-center shadow-sm">
          <img
            src={platform.logo}
            alt={`Logo de ${platform.name}`}
            class="w-full h-full object-contain"
            width="96"
            height="96"
          />
        </div>
        <div>
          <div class="flex flex-wrap items-center gap-2 mb-1.5">
            <span class="text-xs font-semibold px-2.5 py-0.5 rounded-full bg-slate-100 text-slate-700 border border-slate-200">
              {platform.category}
            </span>
            {platform.badge && (
              <span class="text-xs font-bold px-2.5 py-0.5 rounded-full bg-emerald-50 text-emerald-800 border border-emerald-200">
                ★ {platform.badge}
              </span>
            )}
          </div>
          <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900">
            {platform.name}
          </h1>
          {platform.rating && (
            <div class="flex items-center gap-2 mt-2">
              <div class="flex items-center text-amber-500">
                {Array.from({ length: 5 }).map((_, i) => (
                  <svg class={`w-4 h-4 ${i < Math.floor(platform.rating || 0) ? 'fill-current' : 'text-slate-300'}`} viewBox="0 0 20 20">
                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                  </svg>
                ))}
              </div>
              <span class="text-sm font-bold text-slate-800">{platform.rating.toFixed(1)}/5.0</span>
              {platform.reviewsCount && (
                <span class="text-xs text-slate-500">({platform.reviewsCount} avaliações)</span>
              )}
            </div>
          )}
        </div>
      </div>

      <!-- Pricing & Primary CTA -->
      <div class="flex flex-col sm:items-end justify-center bg-slate-50 p-5 rounded-2xl border border-slate-200">
        <span class="text-xs text-slate-500 uppercase font-bold tracking-wider">Ganhos Estimados</span>
        <div class="text-3xl font-extrabold text-emerald-600 font-display my-1">
          {formatPricing()}
        </div>
        <p class="text-xs text-slate-600 mb-3">
          Saque: <strong class="text-slate-800">{platform.payment.avgTime || 'Regular'}</strong> · Mínimo: <strong class="text-slate-800">{platform.payment.minWithdrawal || 'N/A'}</strong>
        </p>

        <!-- PLACEHOLDER: O botão direciona para o link de indicação do proprietário -->
        <a
          href={platform.affiliateUrl || '#'}
          onclick="return gtag_report_conversion(this.href);"
          data-affiliate-link="true"
          data-platform={normalizedPlatformId}
          data-position="hero"
          data-cta="quero_me_cadastrar"
          target={platform.affiliateUrl ? "_blank" : "_self"}
          rel={platform.affiliateUrl ? "noopener noreferrer" : ""}
          class="w-full sm:w-auto inline-flex items-center justify-center px-6 py-3 rounded-xl text-sm font-bold text-white bg-emerald-600 hover:bg-emerald-700 transition-all shadow-md shadow-emerald-600/20 hover:shadow-lg"
        >
          Criar conta e começar
          <svg class="w-4 h-4 ml-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </a>
      </div>

    </div>

    {platform.summary && (
      <div class="mt-8 pt-6 border-t border-slate-100 text-slate-700 text-base leading-relaxed font-normal">
        {platform.summary}
      </div>
    )}
  </div>

  <!-- Pros & Cons Grid -->
  {(platform.pros.length > 0 || platform.cons.length > 0) && (
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      
      <!-- Pros -->
      <div class="rounded-2xl p-6 sm:p-8 border border-emerald-200 bg-emerald-50/60 shadow-sm">
        <h2 class="text-lg font-bold text-emerald-800 flex items-center gap-2 mb-4">
          <svg class="w-5 h-5 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
          </svg>
          Pontos Fortes (Prós)
        </h2>
        <ul class="space-y-3">
          {platform.pros.map((pro) => (
            <li class="flex items-start gap-3 text-sm text-slate-800">
              <span class="text-emerald-600 font-bold mt-0.5 flex-shrink-0">✓</span>
              <span>{pro}</span>
            </li>
          ))}
        </ul>
      </div>

      <!-- Cons -->
      <div class="rounded-2xl p-6 sm:p-8 border border-rose-200 bg-rose-50/60 shadow-sm">
        <h2 class="text-lg font-bold text-rose-800 flex items-center gap-2 mb-4">
          <svg class="w-5 h-5 text-rose-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12" />
          </svg>
          O que você deve saber (Contras)
        </h2>
        <ul class="space-y-3">
          {platform.cons.map((con) => (
            <li class="flex items-start gap-3 text-sm text-slate-800">
              <span class="text-rose-600 font-bold mt-0.5 flex-shrink-0">✕</span>
              <span>{con}</span>
            </li>
          ))}
        </ul>
      </div>

    </div>
  )}

  <!-- Technical Requirements -->
  <div class="bg-white rounded-3xl p-6 sm:p-8 border border-slate-200/90 shadow-sm space-y-6">
    <div>
      <h2 class="text-2xl font-bold text-slate-900 mb-2">Requisitos Técnicos de Gravação</h2>
      <p class="text-sm text-slate-600">Critérios fundamentais exigidos para ter seus vídeos aprovados e faturar sem retrabalho.</p>
    </div>

    <!-- Quick specs grid -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
      <div class="p-4 rounded-xl bg-slate-50 border border-slate-200">
        <span class="text-[11px] text-slate-500 uppercase font-bold">Duração por Vídeo</span>
        <p class="text-base font-bold text-slate-900 mt-1">{platform.technicalRequirements.duration || 'Não especificado'}</p>
      </div>

      <div class="p-4 rounded-xl bg-slate-50 border border-slate-200">
        <span class="text-[11px] text-slate-500 uppercase font-bold">Formato e Resolução</span>
        <p class="text-base font-bold text-slate-900 mt-1">{platform.technicalRequirements.format || '1080p horizontal'}</p>
      </div>

      <div class="p-4 rounded-xl bg-slate-50 border border-slate-200">
        <span class="text-[11px] text-slate-500 uppercase font-bold">Posicionamento Mãos</span>
        <p class="text-base font-bold text-slate-900 mt-1">{platform.technicalRequirements.hands || 'Visíveis na cena'}</p>
      </div>

      <div class="p-4 rounded-xl bg-slate-50 border border-slate-200">
        <span class="text-[11px] text-slate-500 uppercase font-bold">Abertura de Câmera / Zoom</span>
        <p class="text-base font-bold text-slate-900 mt-1">{platform.technicalRequirements.zoom || '0.5x Ultra-wide'}</p>
      </div>
    </div>

    <!-- Compatible Phones -->
    <div class="mt-6 pt-6 border-t border-slate-100">
      <h3 class="text-base font-bold text-slate-900 mb-3">Modelos de Celular Homologados:</h3>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        
        <div class="p-4 rounded-xl bg-slate-50 border border-slate-200">
          <div class="flex items-center gap-2 font-bold text-slate-900 mb-1.5 text-sm">
            <span class="text-slate-600"></span> Apple iPhone
          </div>
          <p class="text-xs text-slate-600 leading-relaxed">
            {platform.technicalRequirements.compatiblePhones.iphone || 'Consulte lista completa no app.'}
          </p>
        </div>

        <div class="p-4 rounded-xl bg-slate-50 border border-slate-200">
          <div class="flex items-center gap-2 font-bold text-slate-900 mb-1.5 text-sm">
            <span class="text-blue-600">G</span> Google Pixel
          </div>
          <p class="text-xs text-slate-600 leading-relaxed">
            {platform.technicalRequirements.compatiblePhones.pixel || 'Modelos modernos com câmera angular.'}
          </p>
        </div>

        <div class="p-4 rounded-xl bg-slate-50 border border-slate-200">
          <div class="flex items-center gap-2 font-bold text-slate-900 mb-1.5 text-sm">
            <span class="text-indigo-600">S</span> Samsung Galaxy S
          </div>
          <p class="text-xs text-slate-600 leading-relaxed">
            {platform.technicalRequirements.compatiblePhones.galaxyS || 'Linha S recente e compatíveis.'}
          </p>
        </div>

      </div>
    </div>
  </div>

  <!-- Payment & Bonus Section -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    
    <!-- Payment rules -->
    <div class="bg-white rounded-2xl p-6 sm:p-8 border border-slate-200/90 shadow-sm space-y-4">
      <h2 class="text-xl font-bold text-slate-900 flex items-center gap-2">
        <svg class="w-5 h-5 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 9V7a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2m2 4h10a2 2 0 002-2v-6a2 2 0 00-2-2H9a2 2 0 00-2 2v6a2 2 0 002 2zm7-5a2 2 0 11-4 0 2 2 0 014 0z" />
        </svg>
        Regras de Pagamento
      </h2>
      <div class="space-y-3 text-sm">
        <div class="flex justify-between py-2 border-b border-slate-100">
          <span class="text-slate-500">Saque Mínimo:</span>
          <span class="font-bold text-slate-900">{platform.payment.minWithdrawal || 'R$ 25'}</span>
        </div>
        <div class="flex justify-between py-2 border-b border-slate-100">
          <span class="text-slate-500">Frequência dos Repasses:</span>
          <span class="font-bold text-slate-900">{platform.payment.avgTime || 'Semanal'}</span>
        </div>
        <div class="flex justify-between py-2 border-b border-slate-100">
          <span class="text-slate-500">Métodos Aceitos:</span>
          <div class="flex gap-1.5">
            {platform.payment.methods.map((m) => (
              <span class="px-2 py-0.5 rounded bg-emerald-50 text-emerald-800 text-xs font-semibold border border-emerald-200">{m}</span>
            ))}
          </div>
        </div>
      </div>
    </div>

    <!-- Bonuses table -->
    <div class="bg-white rounded-2xl p-6 sm:p-8 border border-slate-200/90 shadow-sm space-y-4">
      <h2 class="text-xl font-bold text-slate-900 flex items-center gap-2">
        <svg class="w-5 h-5 text-amber-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        Bônus e Campanhas Turbinadas
      </h2>
      {platform.bonuses.length > 0 ? (
        <div class="space-y-2.5">
          {platform.bonuses.map((bonus) => (
            <div class="flex items-center justify-between p-2.5 rounded-lg bg-slate-50 border border-slate-200 text-xs">
              <span class="text-slate-700 font-medium">{bonus.label}</span>
              <span class="font-bold text-amber-700 bg-amber-50 px-2 py-0.5 rounded border border-amber-200">{bonus.value}</span>
            </div>
          ))}
        </div>
      ) : (
        <p class="text-xs text-slate-500">Nenhum bônus adicional ativo no momento.</p>
      )}
    </div>

  </div>

  <!-- Signup Steps -->
  {platform.signupSteps.length > 0 && (
    <div class="bg-white rounded-3xl p-6 sm:p-8 border border-slate-200/90 shadow-sm space-y-6">
      <h2 class="text-2xl font-bold text-slate-900">Como se Cadastrar no {platform.name}</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {platform.signupSteps.map((step, idx) => (
          <div class="p-4 rounded-2xl bg-slate-50 border border-slate-200 flex gap-3">
            <span class="w-7 h-7 rounded-lg bg-emerald-600 text-white font-extrabold flex items-center justify-center text-sm flex-shrink-0">
              {idx + 1}
            </span>
            <p class="text-xs text-slate-700 leading-relaxed font-normal">{step}</p>
          </div>
        ))}
      </div>
    </div>
  )}

  <!-- Platform Specific FAQ -->
  {platform.faq && platform.faq.length > 0 && (
    <div class="bg-white rounded-3xl p-6 sm:p-8 border border-slate-200/90 shadow-sm space-y-4">
      <h2 class="text-2xl font-bold text-slate-900 mb-4">Dúvidas Frequentes sobre {platform.name}</h2>
      <div class="space-y-3">
        {platform.faq.map((item) => (
          <div class="p-4 rounded-xl bg-slate-50 border border-slate-200 space-y-1">
            <p class="text-sm font-bold text-slate-900">{item.question}</p>
            <p class="text-xs text-slate-600 leading-relaxed">{item.answer}</p>
          </div>
        ))}
      </div>
    </div>
  )}

  <!-- Final CTA Bar -->
  <div class="p-8 rounded-3xl bg-gradient-to-r from-emerald-50 via-teal-50 to-emerald-50 border border-emerald-200 text-center space-y-4 shadow-sm">
    <h3 class="text-2xl font-bold text-slate-900">
      Pronto para começar a faturar no {platform.name}?
    </h3>
    <p class="text-sm text-slate-600 max-w-xl mx-auto">
      Utilize o link exclusivo com código de indicação para garantir acesso prioritário às campanhas e aos bônus de novos membros.
    </p>
    <div class="pt-2">
      <!-- PLACEHOLDER: O link leva ao affiliateUrl da plataforma -->
      <a
        href={platform.affiliateUrl || '#'}
        onclick="return gtag_report_conversion(this.href);"
        data-affiliate-link="true"
        data-platform={normalizedPlatformId}
        data-position="bottom"
        data-cta="quero_me_cadastrar"
        target={platform.affiliateUrl ? "_blank" : "_self"}
        rel={platform.affiliateUrl ? "noopener noreferrer" : ""}
        class="inline-flex items-center justify-center px-8 py-4 rounded-xl text-base font-bold text-white bg-emerald-600 hover:bg-emerald-700 transition-all shadow-md shadow-emerald-600/20 hover:scale-105"
      >
        Acessar cadastro oficial do {platform.name}
        <svg class="w-5 h-5 ml-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>
    </div>
  </div>

</div>
