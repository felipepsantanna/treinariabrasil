---
const currentYear = new Date().getFullYear();
---

<footer class="mt-auto bg-brand-surface border-t-2 border-brand-border text-slate-300 text-sm">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 lg:py-16">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8 lg:gap-12">
      
      <!-- Brand & Mission Column -->
      <div class="md:col-span-1 space-y-4">
        <a href="/" class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-brand-accent-light to-emerald-600 flex items-center justify-center text-brand-dark font-extrabold shadow-sm">
            <svg class="w-6 h-6 text-brand-dark" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
          </div>
          <span class="text-xl font-bold font-display text-white tracking-tight">
            Treinar IA <span class="text-brand-accent-light">Brasil</span>
          </span>
        </a>
        <p class="text-xs sm:text-sm text-slate-200 leading-relaxed font-normal">
          O portal número 1 em oportunidades de renda extra com treinamento de modelos de visão computacional e inteligência artificial no Brasil. Ganhe em dólar e receba via Pix.
        </p>

        <!-- Social / Community Channels (PLACEHOLDER) -->
        <div class="pt-2">
          <p class="text-xs font-bold text-white uppercase tracking-wider mb-2">Comunidade Oficial</p>
          <div class="flex items-center gap-3">
            <!-- PLACEHOLDER: Adicione os links reais da sua comunidade WhatsApp ou canal Telegram -->
            <a
              href="https://t.me/PLACEHOLDER_CANAL_TELEGRAM"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-3.5 py-2 rounded-xl bg-brand-card hover:bg-slate-800 text-white border-2 border-slate-600 hover:border-slate-400 transition-colors text-xs font-bold"
              title="Entrar no Telegram Oficial"
            >
              <svg class="w-4 h-4 text-sky-400" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.64 6.8c-.15 1.58-.8 5.42-1.13 7.19-.14.75-.42 1-.68 1.03-.58.05-1.02-.38-1.58-.75-.88-.58-1.38-.94-2.23-1.5-.99-.65-.35-1.01.22-1.59.15-.15 2.71-2.48 2.76-2.69a.2.2 0 00-.05-.18c-.06-.05-.14-.03-.21-.02-.09.02-1.49.95-4.22 2.79-.4.27-.76.41-1.08.4-.36-.01-1.04-.2-1.55-.37-.63-.2-1.12-.31-1.08-.66.02-.18.27-.36.74-.55 2.92-1.27 4.86-2.11 5.83-2.52 2.77-1.17 3.35-1.37 3.73-1.38.08 0 .27.02.39.12.1.08.13.19.14.27-.01.06.01.24 0 .38z"/>
              </svg>
              Telegram
            </a>
            <a
              href="https://chat.whatsapp.com/PLACEHOLDER_GRUPO_WHATSAPP"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-3.5 py-2 rounded-xl bg-brand-card hover:bg-slate-800 text-white border-2 border-slate-600 hover:border-slate-400 transition-colors text-xs font-bold"
              title="Grupo WhatsApp"
            >
              <svg class="w-4 h-4 text-emerald-400" viewBox="0 0 24 24" fill="currentColor">
                <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/>
              </svg>
              WhatsApp
            </a>
          </div>
        </div>
      </div>

      <!-- Quick Links -->
      <div class="space-y-3">
        <p class="text-xs font-bold text-white uppercase tracking-wider">Navegação</p>
        <ul class="space-y-2.5 text-xs sm:text-sm">
          <li><a href="/como-funciona" class="text-slate-200 hover:text-emerald-300 font-medium transition-colors">Como Funciona</a></li>
          <li><a href="/plataformas" class="text-slate-200 hover:text-emerald-300 font-medium transition-colors">Todas as Plataformas</a></li>
          <li><a href="/#simulador" class="text-slate-200 hover:text-emerald-300 font-medium transition-colors">Simulador de Ganhos</a></li>
          <li><a href="/vagas" class="text-slate-200 hover:text-emerald-300 font-medium transition-colors">Painel de Vagas Abertas</a></li>
          <li><a href="/blog" class="text-slate-200 hover:text-emerald-300 font-medium transition-colors">Blog & Dicas de Gravação</a></li>
          <li><a href="/#faq" class="text-slate-200 hover:text-emerald-300 font-medium transition-colors">Perguntas Frequentes (FAQ)</a></li>
        </ul>
      </div>

      <!-- Top Platforms -->
      <div class="space-y-3">
        <p class="text-xs font-bold text-white uppercase tracking-wider">Plataformas em Destaque</p>
        <ul class="space-y-2.5 text-xs sm:text-sm">
          <li><a href="/plataformas/hub-xyz" class="text-slate-200 hover:text-emerald-300 font-medium transition-colors">Hub.xyz (Recomendada · Pix)</a></li>
          <li><a href="/plataformas/flambra" class="text-slate-200 hover:text-emerald-300 font-medium transition-colors">Flambra (100% Brasileira)</a></li>
          <li><a href="/plataformas/invent-money" class="text-slate-200 hover:text-emerald-300 font-medium transition-colors">Invent Money (Em Expansão)</a></li>
          <li><a href="/plataformas/toloka" class="text-slate-200 hover:text-emerald-300 font-medium transition-colors">Toloka AI Tasks</a></li>
        </ul>
      </div>

      <!-- Legal & Compliance -->
      <div class="space-y-3">
        <p class="text-xs font-bold text-white uppercase tracking-wider">Legal & Transparência</p>
        <ul class="space-y-2.5 text-xs sm:text-sm">
          <li><a href="/termos-de-uso" class="text-slate-200 hover:text-white font-medium transition-colors">Termos de Uso</a></li>
          <li><a href="/politica-de-privacidade" class="text-slate-200 hover:text-white font-medium transition-colors">Política de Privacidade (LGPD)</a></li>
          <li><a href="/#faq" class="text-slate-200 hover:text-white font-medium transition-colors">Transparência de Pagamentos</a></li>
        </ul>
      </div>

    </div>

    <!-- Mandatory Affiliate Disclaimer Box with enhanced contrast -->
    <div class="mt-12 pt-6 border-t border-slate-700">
      <div class="p-5 rounded-2xl bg-brand-card border-2 border-slate-700 text-xs sm:text-sm text-slate-200 space-y-2 shadow-lg">
        <div class="flex items-center gap-2 text-white font-bold">
          <svg class="w-5 h-5 text-amber-400 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          Aviso de Transparência e Afiliados
        </div>
        <p class="leading-relaxed font-normal">
          Este site pode conter links de afiliados. Ao se cadastrar através deles, podemos receber uma comissão, sem custo adicional para você. Todas as plataformas e ferramentas recomendadas passam por nossa curadoria editorial independente com foco em segurança, métodos de pagamento viáveis para o Brasil e histórico comprovado.
        </p>
      </div>
    </div>

    <!-- Copyright -->
    <div class="mt-8 flex flex-col sm:flex-row items-center justify-between text-xs text-slate-400 gap-4 font-medium">
      <p>© {currentYear} Treinar IA Brasil (treinariabrasil.com.br). Todos os direitos reservados.</p>
      <p>Desenvolvido para conectar brasileiros às melhores oportunidades globais de IA.</p>
    </div>

  </div>
</footer>
