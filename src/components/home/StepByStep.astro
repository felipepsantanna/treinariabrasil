---
const steps = [
  {
    number: '01',
    title: 'Cadastro com indicação',
    desc: 'Crie sua conta em uma das plataformas aprovadas usando o link oficial para ter acesso aos bônus de boas-vindas.',
    icon: 'M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z'
  },
  {
    number: '02',
    title: 'Suporte de cabeça',
    desc: 'Use uma cinta elástica (head strap) de R$ 30 para prender o celular na altura dos olhos de forma estável.',
    icon: 'M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z'
  },
  {
    number: '03',
    title: 'Instalação do app',
    desc: 'Baixe o aplicativo oficial fornecido pela plataforma no seu iPhone, Pixel ou Galaxy e calibre o ângulo de visão.',
    icon: 'M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z'
  },
  {
    number: '04',
    title: 'Gravação da tarefa',
    desc: 'Escolha uma atividade (doméstica ou comercial) e grave em 1080p horizontal mantendo as duas mãos visíveis.',
    icon: 'M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z'
  },
  {
    number: '05',
    title: 'Aprovação do vídeo',
    desc: 'O vídeo é enviado pelo Wi-Fi e validado em poucas horas pelo sistema de inteligência artificial da empresa.',
    icon: 'M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z'
  },
  {
    number: '06',
    title: 'Saque no Pix',
    desc: 'O valor acumulado em dólar é convertido e transferido direto para sua chave Pix cadastrada toda semana.',
    icon: 'M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z'
  }
];
---

<section id="como-funciona" class="py-16 lg:py-24 bg-slate-100/60 border-b border-slate-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="text-xs font-bold uppercase tracking-wider text-emerald-800 bg-emerald-50 px-3 py-1 rounded-full border border-emerald-200">
        Processo Simples
      </span>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 mt-4">
        Como funciona em 6 passos simples
      </h2>
      <p class="text-slate-600 text-base sm:text-lg mt-3 font-normal">
        Da instalação à primeira transferência na sua conta bancária sem complicações ou burocracia.
      </p>
    </div>

    <!-- 6 Steps Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {steps.map((step) => (
        <div class="bg-white rounded-2xl p-6 sm:p-7 border border-slate-200/90 shadow-sm hover:border-emerald-300 hover:shadow-md transition-all flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="text-3xl font-black font-display text-emerald-600">
                {step.number}
              </span>
              <div class="w-11 h-11 rounded-xl bg-emerald-50 border border-emerald-100 flex items-center justify-center text-emerald-700">
                <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={step.icon} />
                </svg>
              </div>
            </div>
            <h3 class="text-lg font-bold text-slate-900 mb-2">{step.title}</h3>
            <p class="text-sm text-slate-600 leading-relaxed font-normal">{step.desc}</p>
          </div>
        </div>
      ))}
    </div>

    <!-- Bottom tip -->
    <div class="mt-12 text-center">
      <div class="inline-flex items-center gap-2.5 bg-white px-5 py-2.5 rounded-full border border-slate-200 text-sm text-slate-700 shadow-sm">
        <span class="text-emerald-700 font-bold">💡 Dica de ouro:</span>
        Você pode começar gravando 30 a 60 minutos por dia nos seus horários livres.
      </div>
    </div>

  </div>
</section>
