---
import { getCollection } from 'astro:content';

const allPlatforms = await getCollection('platforms');
const publishedCount = allPlatforms.filter((p) => p.data.status === 'published').length;
---

<section class="py-10 bg-white border-y border-slate-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 sm:gap-6">
      
      <!-- Stat 1: Published Platforms -->
      <div class="text-center p-5 rounded-2xl bg-slate-50 border border-slate-200/80 hover:border-slate-300 transition-colors shadow-sm">
        <div class="text-3xl sm:text-4xl font-black font-display text-slate-900">
          {publishedCount} <span class="text-emerald-600 text-2xl font-bold">+</span>
        </div>
        <div class="text-xs sm:text-sm text-slate-800 font-bold mt-1.5">
          {publishedCount === 1 ? 'Plataforma homologada' : 'Plataformas homologadas'}
        </div>
        <div class="text-[11px] text-slate-500 mt-0.5">Testadas no Brasil</div>
      </div>

      <!-- Stat 2: Hourly Rate -->
      <div class="text-center p-5 rounded-2xl bg-slate-50 border border-slate-200/80 hover:border-slate-300 transition-colors shadow-sm">
        <div class="text-3xl sm:text-4xl font-black font-display text-emerald-600">
          $5 a $8<span class="text-base font-semibold text-slate-500">/h</span>
        </div>
        <div class="text-xs sm:text-sm text-slate-800 font-bold mt-1.5">
          Remuneração por hora
        </div>
        <div class="text-[11px] text-emerald-700 font-semibold mt-0.5">~R$ 28 a R$ 46/hora</div>
      </div>

      <!-- Stat 3: Withdrawal -->
      <div class="text-center p-5 rounded-2xl bg-slate-50 border border-slate-200/80 hover:border-slate-300 transition-colors shadow-sm">
        <div class="text-3xl sm:text-4xl font-black font-display text-slate-900">
          Pix <span class="text-emerald-600 text-lg font-bold">Semanal</span>
        </div>
        <div class="text-xs sm:text-sm text-slate-800 font-bold mt-1.5">
          Saque direto na conta
        </div>
        <div class="text-[11px] text-slate-500 mt-0.5">Mínimo a partir de R$ 25</div>
      </div>

      <!-- Stat 4: Experience Required -->
      <div class="text-center p-5 rounded-2xl bg-slate-50 border border-slate-200/80 hover:border-slate-300 transition-colors shadow-sm">
        <div class="text-3xl sm:text-4xl font-black font-display text-emerald-600">
          Zero
        </div>
        <div class="text-xs sm:text-sm text-slate-800 font-bold mt-1.5">
          Experiência prévia
        </div>
        <div class="text-[11px] text-slate-500 mt-0.5">Tarefas comuns da rotina</div>
      </div>

    </div>
  </div>
</section>
