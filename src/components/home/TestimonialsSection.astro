---
const testimonials = [
  {
    name: 'Carlos M.',
    location: 'Belo Horizonte, MG',
    role: 'Gravador na Hub.xyz',
    text: 'Comecei gravando preparando o café da manhã e lavando louça com o celular na cabeça. Na minha primeira semana fiz US$ 120 e caiu no meu Pix certinho na terça-feira. Hoje é minha principal fonte de renda extra.',
    earnings: 'R$ 2.450 no último mês',
    avatar: 'CM'
  },
  {
    name: 'Juliana S.',
    location: 'São Paulo, SP',
    role: 'Gravadora Hub.xyz e Flambra',
    text: 'Achei que era mentira pagar para gravar vídeo limpando a casa, mas é 100% sério. Os robôs precisam ver as mãos se movendo. Em menos de 10 dias eu paguei o suporte de cabeça que comprei na internet.',
    earnings: 'R$ 1.890 no último mês',
    avatar: 'JS'
  },
  {
    name: 'Rodrigo T.',
    location: 'Curitiba, PR',
    role: 'Gravador de Tarefas Comerciais',
    text: 'Como trabalho em oficina, aproveitei as tarefas comerciais turbinadas que pagam $8 por hora. Consegui uma renda extra considerável no fim do mês sem atrapalhar minhas funções.',
    earnings: 'R$ 3.200 no último mês',
    avatar: 'RT'
  }
];
---

<section class="py-16 lg:py-24 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
  <div class="text-center max-w-3xl mx-auto mb-14">
    <span class="text-xs font-bold uppercase tracking-wider text-emerald-800 bg-emerald-50 px-3 py-1 rounded-full border border-emerald-200">
      Depoimentos Verificados
    </span>
    <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 mt-4">
      Quem já está faturando com Treinamento de IA
    </h2>
    <p class="text-slate-600 text-base sm:text-lg mt-2 font-normal">
      Histórias reais de membros da nossa comunidade que transformaram atividades cotidianas em dólares no Pix.
    </p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
    {testimonials.map((item) => (
      <div class="bg-white rounded-2xl p-7 border border-slate-200/90 shadow-sm hover:border-slate-300 transition-all flex flex-col justify-between space-y-5">
        <div class="space-y-4">
          <!-- Stars -->
          <div class="flex text-amber-400">
            {Array.from({ length: 5 }).map(() => (
              <svg class="w-5 h-5 fill-current" viewBox="0 0 20 20">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
              </svg>
            ))}
          </div>

          <p class="text-sm text-slate-700 leading-relaxed font-normal italic">
            "{item.text}"
          </p>
        </div>

        <div class="pt-5 border-t border-slate-100 flex items-center justify-between">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-full bg-slate-100 text-slate-800 font-bold flex items-center justify-center text-sm border border-slate-200">
              {item.avatar}
            </div>
            <div>
              <p class="text-sm font-bold text-slate-900">{item.name}</p>
              <p class="text-xs text-slate-500">{item.location}</p>
            </div>
          </div>
          <span class="text-xs font-bold text-emerald-800 bg-emerald-50 px-3 py-1 rounded-md border border-emerald-200">
            {item.earnings}
          </span>
        </div>
      </div>
    ))}
  </div>
</section>
